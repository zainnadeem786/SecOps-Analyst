OLLAMA_URL=
# Optional backward-compatible fallback if you still use the legacy name:
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=120
ALLOWED_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/secops_analyst
JWT_SECRET_KEY=change-this-secret-before-production
AUTH_COOKIE_NAME=secops_access_token
AUTH_TOKEN_TTL_HOURS=12
GUEST_ANALYSIS_LIMIT=3
SHARE_LINK_TTL_HOURS=168
GEOIP_ENABLED=true
GEOIP_PROVIDER_URL=http://ip-api.com/json
GEOIP_TIMEOUT_SECONDS=5
GEOIP_CACHE_TTL_SECONDS=86400
RULES_FILE_PATH=app/config/rules.json
WEBSOCKET_FLUSH_LINE_COUNT=25
WEBSOCKET_FLUSH_INTERVAL_SECONDS=2
ALERT_RISK_THRESHOLD=85
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_USE_TLS=true
